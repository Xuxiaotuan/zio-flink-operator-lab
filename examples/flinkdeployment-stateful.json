{
  "apiVersion": "flink.apache.org/v1beta1",
  "kind": "FlinkDeployment",
  "metadata": {
    "name": "zio-e2e-stateful",
    "namespace": "bigdata-lab"
  },
  "spec": {
    "image": "100.97.53.78:5001/xxt/zio-flink-stateful-job:latest",
    "imagePullPolicy": "IfNotPresent",
    "flinkVersion": "v1_20",
    "serviceAccount": "flink",
    "flinkConfiguration": {
      "execution.checkpointing.interval": "5s",
      "state.checkpoints.dir": "s3://flink-savepoints/zio-e2e/checkpoints/",
      "state.savepoints.dir": "s3://flink-savepoints/zio-e2e/savepoints/",
      "s3.endpoint": "http://rustfs.bigdata-lab.svc.cluster.local:9000",
      "s3.path.style.access": "true",
      "kubernetes.env.secretKeyRef": "env:AWS_ACCESS_KEY_ID,secret:rustfs-credentials,key:access-key;env:AWS_SECRET_ACCESS_KEY,secret:rustfs-credentials,key:secret-key"
    },
    "jobManager": {"resource": {"cpu": 1, "memory": "1024m"}},
    "taskManager": {"resource": {"cpu": 1, "memory": "1024m"}},
    "job": {
      "jarURI": "local:///opt/flink/usrlib/zio-flink-jobs.jar",
      "entryClass": "cn.xuyinyin.flinklab.job.StatefulCounterJob",
      "parallelism": 1,
      "upgradeMode": "last-state",
      "state": "running"
    }
  }
}
